# Copy to infra/env.sh (gitignored), fill in the project ID, then:
#   source infra/env.sh
export PROJECT_ID="wobot-dev-xxxx"
export REGION="asia-east1"
export AR_REPO="wobot"
export SQL_INSTANCE="wobot-pg"
export DB_NAME="wobot"
export INSTANCE_CONNECTION_NAME="${PROJECT_ID}:${REGION}:${SQL_INSTANCE}"
export KNOWLEDGE_BUCKET="${PROJECT_ID}-knowledge"
