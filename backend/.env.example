# Copy to .env for local development; .env is gitignored.
GOOGLE_CLOUD_PROJECT=wobot-dev-xxxx
DB_MODE=local
DB_USER=wobot_api_user
DB_PASSWORD=wobot
# For wobot-ingest run/search; a separate dev key keeps local usage apart.
# OPENAI_API_KEY=
# LangSmith tracing, local only (DEC-057). Settings ignores these; the SDK reads the
# process environment, so run with `uv run --env-file .env ...`.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wobot-dev
